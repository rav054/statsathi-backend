# Copy this file to .env and fill in real values. .env is gitignored.

# Local development uses SQLite so it never touches the production database.
# Production example: postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./statsathi_local.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-64-character-random-hex-string

# --- Account emails (password reset, email verification) ---------------------------------------------
# Where the web app is served; links in emails point here. Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# console = write emails to the server log (development). smtp = send them.
EMAIL_BACKEND=console
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls (587), ssl (465) or none
# SMTP_USERNAME=no-reply@example.org
# SMTP_PASSWORD=app-password-or-api-key
# SMTP_FROM=StatSathi <no-reply@example.org>

# --- Sign-in protection ------------------------------------------------------------------------------
# Rate limits on login, signup and reset emails are on by default.
# RATE_LIMIT_ENABLED=true
# Behind a proxy such as Render, the visitor's address is in X-Forwarded-For. Set true there.
# TRUST_PROXY_HEADERS=false

# --- Deployment ----------------------------------------------------------------------------------------
# Web app addresses allowed to call the API (localhost dev servers are always allowed), comma separated.
# CORS_ORIGINS=https://statsathi.vercel.app
# Pattern of allowed addresses; the default admits every *.vercel.app site. Narrow it (or set it empty)
# once CORS_ORIGINS lists your own address.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Largest request body (MB) and largest CSV/Excel file an analysis reads (MB).
# MAX_REQUEST_MB=50
# MAX_TABLE_UPLOAD_MB=25
# Interactive API docs at /docs and /redoc.
# API_DOCS_ENABLED=true
# Uptime monitors can poll GET /health (503 when the database is unreachable).

