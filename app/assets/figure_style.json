  "default_preset": "screen",
  "presets": {
    "screen": {
      "label": "Screen & slides",
      "width_mm": 170,
      "aspect": 0.7,
      "font_pt": 10,
      "title_pt": 12,
      "line_width": 1.5,
      "axis_width": 0.8,
      "marker_size": 6,
      "dpi": 150
    },
    "single_column": {
      "label": "Journal: single column (85 mm)",
      "width_mm": 85,
      "aspect": 0.8,
      "font_pt": 7,
      "title_pt": 8,
      "line_width": 0.9,
      "axis_width": 0.5,
      "marker_size": 3.5,
      "dpi": 600
    },
    "one_half_column": {
      "label": "Journal: 1.5 column (120 mm)",
      "width_mm": 120,
      "aspect": 0.75,
      "font_pt": 8,
      "title_pt": 9,
      "line_width": 1.0,
      "axis_width": 0.6,
      "marker_size": 4,
      "dpi": 600
    },
    "double_column": {
      "label": "Journal: double column (180 mm)",
      "width_mm": 180,
      "aspect": 0.6,
      "font_pt": 8,
      "title_pt": 9,
      "line_width": 1.0,
      "axis_width": 0.6,
      "marker_size": 4,
      "dpi": 600
    },
    "thesis": {
      "label": "Thesis / report page (150 mm)",
      "width_mm": 150,
      "aspect": 0.7,
      "font_pt": 10,
      "title_pt": 11,
      "line_width": 1.2,
      "axis_width": 0.7,
      "marker_size": 5,
      "dpi": 300
    },
    "poster": {
      "label": "Poster (300 mm)",
      "width_mm": 300,
      "aspect": 0.7,
      "font_pt": 20,
      "title_pt": 24,
      "line_width": 2.5,
      "axis_width": 1.5,
      "marker_size": 10,
      "dpi": 300
    }
  },
  "export_formats": {
    "server": [
      "png",
      "jpeg",
      "tiff",
      "svg",
      "pdf",
      "eps"
    ],
    "browser": [
      "png",
      "jpeg",
      "svg"
    ]
  },
  "colors_dark": {
    "text": "#E8ECF4",
    "muted": "#8A96AD",
    "axis": "#334155",
    "grid": "#1E2A40",
    "background": "#111A2E"
  }
}
