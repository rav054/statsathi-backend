{
  "version": 2,
  "font": {
    "css": "Instrument Sans, Segoe UI, system-ui, sans-serif",
    "matplotlib": [
      "Instrument Sans",
      "Segoe UI",
      "Arial",
      "Helvetica",
      "Liberation Sans",
      "DejaVu Sans"
    ],
    "mono_css": "JetBrains Mono, Consolas, monospace"
  },
  "colors": {
    "text": "#0F172A",
    "muted": "#64748B",
    "axis": "#CBD5E1",
    "grid": "#E8EBF1",
    "background": "#FFFFFF"
  },
  "default_palette": "statsathi",
